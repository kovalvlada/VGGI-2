// Vertex shader
const vertexShaderSource = `
attribute vec3 vertex;
attribute vec3 normal;

uniform mat4 ModelViewMatrix;
uniform mat4 ProjectionMatrix;
uniform mat3 NormalMatrix;
uniform vec3 LightPosition; // Координати світла, вже помножені на ModelView у JS

varying vec4 v_color;

void main() {
    // 1. Позиція вершини в системі координат камери (View Space)
    vec4 vertPos4 = ModelViewMatrix * vec4(vertex, 1.0);
    vec3 vertPos = vertPos4.xyz;

    // 2. Перетворення нормалі в View Space та її нормалізація
    vec3 N = normalize(NormalMatrix * normal);

    // 3. Вектор напрямку на джерело світла
    vec3 L = normalize(LightPosition - vertPos);

    // 4. Вектор на спостерігача (модель глобального глядача: (0, 0, 1))
    vec3 V = vec3(0.0, 0.0, 1.0);

    // 5. Вектор віддзеркалення світла
    vec3 R = reflect(-L, N);

    // Властивості матеріалу та світла
    vec3 ambientColor = vec3(0.15, 0.15, 0.2);
    vec3 diffuseColor = vec3(0.2, 0.6, 0.85);
    vec3 specularColor = vec3(1.0, 1.0, 1.0);
    float shininess = 32.0;

    // Компоненти освітлення
    vec3 ambient = ambientColor;

    float diffFactor = max(dot(N, L), 0.0);
    vec3 diffuse = diffFactor * diffuseColor;

    float specFactor = 0.0;
    if (diffFactor > 0.0) {
        specFactor = pow(max(dot(R, V), 0.0), shininess);
    }
    vec3 specular = specFactor * specularColor;

    // Підсумковий колір Гуро для вершини
    v_color = vec4(ambient + diffuse + specular, 1.0);

    gl_Position = ProjectionMatrix * vertPos4;
}`;

// Fragment shader
const fragmentShaderSource = `
#ifdef GL_FRAGMENT_PRECISION_HIGH
   precision highp float;
#else
   precision mediump float;
#endif

varying vec4 v_color;

void main() {
    gl_FragColor = v_color;
}`;